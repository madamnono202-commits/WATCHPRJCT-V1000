# JWT Secret - change this to a strong random string in production
JWT_SECRET=your-secret-key-here-change-in-production

# Default Admin User
ADMIN_EMAIL=admin@wristnerd.xyz
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# Optional: Editor User
# EDITOR_EMAIL=editor@wristnerd.xyz
# EDITOR_PASSWORD=changeme
# EDITOR_NAME=Editor

# Optional: Viewer User
# VIEWER_EMAIL=viewer@wristnerd.xyz
# VIEWER_PASSWORD=changeme
# VIEWER_NAME=Viewer

# Optional: Master admin password (emergency access with any email)
# ADMIN_MASTER_PASSWORD=your-master-password-here

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
